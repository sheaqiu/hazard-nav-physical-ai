<?xml version="1.0"?>
<sdf version="1.9">
  <world name="hazard_facility">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.12 0.12 0.14 1</ambient>
      <background>0.025 0.028 0.035 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="emergency_ceiling_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.72 0.74 0.78 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 12 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 12 0.1</size></box></geometry>
          <material>
            <ambient>0.12 0.13 0.15 1</ambient>
            <diffuse>0.16 0.17 0.19 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Project-built differential-drive rescue rover. -->
    <model name="hazard_rover">
      <pose>-6.2 -4.0 0.13 0 0 0</pose>

      <link name="base_link">
        <pose>0 0 0.07 0 0 0</pose>
        <inertial>
          <mass>4.0</mass>
          <inertia>
            <ixx>0.0273</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0433</iyy><iyz>0</iyz><izz>0.0604</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry><box><size>0.34 0.26 0.12</size></box></geometry>
        </collision>
        <visual name="body_visual">
          <geometry><box><size>0.34 0.26 0.12</size></box></geometry>
          <material>
            <ambient>0.03 0.16 0.26 1</ambient>
            <diffuse>0.04 0.38 0.62 1</diffuse>
            <specular>0.3 0.5 0.7 1</specular>
          </material>
        </visual>
        <visual name="front_marker">
          <pose>0.175 0 0.025 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>1 0.45 0.02 1</ambient>
            <diffuse>1 0.25 0.01 1</diffuse>
            <emissive>0.8 0.12 0 1</emissive>
          </material>
        </visual>

        <sensor name="front_lidar" type="gpu_lidar">
          <pose>0.055 0 0.145 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>12</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>540</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.08</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <always_on>true</always_on>
          <visualize>false</visualize>
        </sensor>

        <sensor name="operator_camera" type="camera">
          <pose>0.16 0 0.115 0 0 0</pose>
          <topic>/camera/image_raw</topic>
          <update_rate>6</update_rate>
          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>480</width>
              <height>270</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>30</far></clip>
          </camera>
          <always_on>true</always_on>
          <visualize>false</visualize>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0.045 0.17 0 -1.5708 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.00037</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00037</iyy><iyz>0</iyz><izz>0.00070</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.03 0.03 0.035 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0.045 -0.17 0 -1.5708 0 0</pose>
        <inertial>
          <mass>0.25</mass>
          <inertia>
            <ixx>0.00037</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00037</iyy><iyz>0</iyz><izz>0.00070</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.03 0.03 0.035 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material>
        </visual>
      </link>

      <link name="rear_caster">
        <pose>-0.135 0 -0.045 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000018</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000018</iyy><iyz>0</iyz><izz>0.000018</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.18 0.18 0.2 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="rear_caster_joint" type="ball">
        <parent>base_link</parent><child>rear_caster</child>
      </joint>

      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.34</wheel_separation>
        <wheel_radius>0.075</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_velocity>0.38</max_linear_velocity>
        <min_linear_velocity>-0.25</min_linear_velocity>
        <max_angular_velocity>1.3</max_angular_velocity>
        <min_angular_velocity>-1.3</min_angular_velocity>
        <max_linear_acceleration>0.8</max_linear_acceleration>
        <min_linear_acceleration>-1.2</min_linear_acceleration>
        <max_angular_acceleration>2.5</max_angular_acceleration>
        <min_angular_acceleration>-2.5</min_angular_acceleration>
      </plugin>
    </model>

    <!-- Outer shell -->
    <model name="wall_north"><static>true</static><pose>0 6 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>16 0.25 2</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.25 2</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.3 0.31 0.34 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -6 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>16 0.25 2</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.25 2</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.3 0.31 0.34 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-8 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.25 12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.25 12 2</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.3 0.31 0.34 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>8 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.25 12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.25 12 2</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.3 0.31 0.34 1</diffuse></material></visual></link></model>

    <!-- Damaged corridor network. The traversable route is deliberately not a grid. -->
    <model name="corridor_a_top"><static>true</static><pose>-4.6 -3.0 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>6.7 0.24 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>6.7 0.24 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>
    <model name="corridor_a_bottom"><static>true</static><pose>-4.6 -5.0 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>6.7 0.24 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>6.7 0.24 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>
    <model name="corridor_b_left"><static>true</static><pose>-2.0 -1.45 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.24 3.1 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.24 3.1 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>
    <model name="corridor_b_right"><static>true</static><pose>0.0 -1.45 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.24 3.1 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.24 3.1 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>
    <model name="corridor_c_bottom"><static>true</static><pose>2.3 -0.9 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4.6 0.24 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>4.6 0.24 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>
    <!-- The upper wall ends at x=3.1, leaving a real doorway into corridor D. -->
    <model name="corridor_c_top"><static>true</static><pose>1.55 1.1 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.1 0.24 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>3.1 0.24 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>
    <model name="corridor_d_left"><static>true</static><pose>3.1 3.25 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.24 4.3 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.24 4.3 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>
    <model name="corridor_d_right"><static>true</static><pose>5.1 3.25 0.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.24 4.3 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.24 4.3 1.6</size></box></geometry><material><ambient>0.24 0.22 0.21 1</ambient><diffuse>0.34 0.31 0.29 1</diffuse></material></visual></link></model>

    <!-- Collapsed structure creates a visible but passable hazard. -->
    <model name="debris_1"><static>true</static><pose>1.5 -0.45 0.18 0.15 0.12 0.4</pose><link name="link"><collision name="c"><geometry><box><size>0.65 0.45 0.36</size></box></geometry></collision><visual name="v"><geometry><box><size>0.65 0.45 0.36</size></box></geometry><material><ambient>0.18 0.12 0.08 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material></visual></link></model>
    <model name="debris_2"><static>true</static><pose>2.2 -0.35 0.14 -0.1 0.2 -0.5</pose><link name="link"><collision name="c"><geometry><box><size>0.48 0.38 0.28</size></box></geometry></collision><visual name="v"><geometry><box><size>0.48 0.38 0.28</size></box></geometry><material><ambient>0.16 0.11 0.07 1</ambient><diffuse>0.3 0.19 0.1 1</diffuse></material></visual></link></model>

    <!-- A forbidden branch is marked by red emissive beacons. -->
    <model name="fire_beacon_left"><static>true</static><pose>-0.65 2.7 0.42 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.84</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.84</length></cylinder></geometry><material><ambient>0.7 0.04 0.01 1</ambient><diffuse>1 0.08 0.01 1</diffuse><emissive>1 0.03 0 1</emissive></material></visual></link></model>
    <model name="fire_beacon_right"><static>true</static><pose>0.65 2.7 0.42 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.84</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.84</length></cylinder></geometry><material><ambient>0.7 0.04 0.01 1</ambient><diffuse>1 0.08 0.01 1</diffuse><emissive>1 0.03 0 1</emissive></material></visual></link></model>
    <light type="point" name="fire_glow"><pose>0 2.9 1.2 0 0 0</pose><diffuse>1 0.12 0.02 1</diffuse><specular>1 0.2 0.03 1</specular><attenuation><range>5</range><constant>0.5</constant><linear>0.3</linear><quadratic>0.08</quadratic></attenuation></light>

    <!-- Start and safe destination are visual markers, not collision objects. -->
    <model name="operator_start_zone"><static>true</static><pose>-6.2 -4.0 0.061 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.65</radius><length>0.02</length></cylinder></geometry><material><ambient>0.02 0.18 0.75 0.8</ambient><diffuse>0.03 0.28 1 0.8</diffuse><emissive>0 0.08 0.3 1</emissive></material></visual></link></model>
    <model name="safe_zone"><static>true</static><pose>4.1 4.75 0.061 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.78</radius><length>0.02</length></cylinder></geometry><material><ambient>0.01 0.65 0.15 0.9</ambient><diffuse>0.02 1 0.25 0.9</diffuse><emissive>0 0.35 0.08 1</emissive></material></visual></link></model>
    <light type="point" name="safe_zone_light"><pose>4.1 4.75 2.2 0 0 0</pose><diffuse>0.05 1 0.2 1</diffuse><specular>0.1 1 0.3 1</specular><attenuation><range>4</range><constant>0.7</constant><linear>0.2</linear><quadratic>0.05</quadratic></attenuation></light>
  </world>
</sdf>

