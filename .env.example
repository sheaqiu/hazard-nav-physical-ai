# Recommended: one OpenRouter key powers both planning and transcription.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_HTTP_REFERER=http://localhost:6080
OPENROUTER_APP_NAME=HazardNav

# Optional native OpenAI fallback. Leave blank when using OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

